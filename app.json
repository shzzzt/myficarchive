{
  "expo": {
    "name": "My Fic Archive",
    "slug": "my-fic-archive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myficarchive.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#d6dcff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.myficarchive.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#c4d8ff",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1c1f3d"
          }
        }
      ],
      "expo-asset"
    ],
    "scheme": "ficarchive",
    "backgroundColor": "#c4d8ff",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0ea2b5f9-2ebe-4fcc-a1a0-ee4534c2d33e"
      }
    }
  }
}
